# Use the same Neon project/database for both URLs. Replace these placeholders.
# Runtime queries and seed data: use the pooled Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Prisma CLI, migrations and database checks: use the direct connection string.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Optional: integration-test server; this is the default when omitted.
TEST_BASE_URL="http://127.0.0.1:3100"
